{
  "type": "object",
  "properties": {
    "invoice_number": { "type": "string", "description": "At least 3 characters." },
    "issued_on": { "type": "string", "format": "date" },
    "currency": { "type": "string", "enum": ["USD", "EUR", "TRY"] },
    "total": { "type": "number", "description": "Zero or more." },
    "notes": { "type": ["string", "null"] },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "quantity": { "type": "integer" },
          "unit_price": { "type": "number" }
        },
        "required": ["description", "quantity", "unit_price"],
        "additionalProperties": false
      }
    }
  },
  "required": ["invoice_number", "issued_on", "currency", "total", "notes", "lines"],
  "additionalProperties": false
}
