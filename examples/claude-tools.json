[
  {
    "name": "search_docs",
    "description": "Search the product documentation.",
    "strict": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "query": { "type": "string", "maxLength": 200 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 50 },
        "sections": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
        "sort": { "type": "string", "enum": ["Relevance", "relevance", "newest"] }
      },
      "required": ["query"],
      "additionalProperties": false
    }
  },
  {
    "name": "create_outline",
    "description": "Create a document outline.",
    "strict": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "root": { "$ref": "#/$defs/node" }
      },
      "required": ["title", "root"],
      "additionalProperties": false,
      "$defs": {
        "node": {
          "type": "object",
          "properties": {
            "heading": { "type": "string" },
            "children": { "type": "array", "items": { "$ref": "#/$defs/node" } }
          },
          "required": ["heading", "children"],
          "additionalProperties": false
        }
      }
    }
  },
  {
    "name": "tag record",
    "description": "Attach free-form tags to a record.",
    "strict": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "record_id": { "type": "string", "format": "uuid" },
        "tags": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "required": ["record_id", "tags"],
      "additionalProperties": false
    }
  }
]
