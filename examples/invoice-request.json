{
  "model": "gpt-5.1",
  "response_format": {
    "type": "json_schema",
    "json_schema": {
      "name": "invoice extraction",
      "strict": true,
      "schema": {
        "type": "object",
        "properties": {
          "invoice_number": { "type": "string", "minLength": 3 },
          "issued_on": { "type": "string", "format": "date" },
          "vendor": { "$ref": "#/$defs/party" },
          "website": { "type": "string", "format": "uri" },
          "currency": { "type": "string", "enum": ["USD", "EUR", "TRY"] },
          "total": { "type": "number", "minimum": 0 },
          "notes": { "type": "string", "nullable": true },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "allOf": [
                { "$ref": "#/$defs/line" },
                { "properties": { "tax_rate": { "type": "number" } } }
              ]
            }
          }
        },
        "required": ["invoice_number", "issued_on", "vendor", "total", "lines"],
        "$defs": {
          "party": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "tax_id": { "type": "string", "pattern": "^(?!0+$)\\d{10,11}$" }
            },
            "required": ["name", "tax_id"],
            "additionalProperties": false
          },
          "line": {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "quantity": { "type": "integer", "minimum": 1 },
              "unit_price": { "type": "number" }
            },
            "required": ["description", "quantity", "unit_price"],
            "additionalProperties": false
          }
        }
      }
    }
  }
}
